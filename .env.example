# Copy to .env and adjust as needed. Docker Compose reads .env automatically.

# Model pulled into the container on first start, and the model Claude Code uses.
# Must support native tool calls - Claude Code is driven by tool use.
# ./container.sh start local|cloud rewrites this line for you.
OLLAMA_MODEL=qwen3:1.7b

# Host port that maps to Ollama inside the container.
# Keep it different from 11434 if you already run Ollama natively on your Mac.
OLLAMA_HOST_PORT=11435

# Context window for the model. Ollama's own default is 4096, which is tight
# for coding tools that send a system prompt plus your source files.
OLLAMA_CONTEXT_LENGTH=16384

# Identity the container uses when committing. The host's ~/.gitconfig is not
# mounted into the container, so it keeps its own.
GIT_USER_NAME=Jiraporn Johansson
GIT_USER_EMAIL=jiraporn.junext@gmail.com

# Absolute path to the folder mounted at /home/workspace inside the container.
WORKSPACE_PATH=/Users/jirapornjohansson/workspace
