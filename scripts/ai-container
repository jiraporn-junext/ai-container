#!/usr/bin/env bash
# Reports the version of the ai-container image this shell is running in.
set -uo pipefail

VERSION_FILE="/etc/ai-container/VERSION"

if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ] || [ "${1:-}" = "version" ]; then
    if [ -f "$VERSION_FILE" ]; then
        cat "$VERSION_FILE"
    else
        echo "unknown"
    fi
    exit 0
fi

cat <<EOF
ai-container $(cat "$VERSION_FILE" 2>/dev/null || echo unknown)

  ollama   http://127.0.0.1:11434  (host: localhost:${OLLAMA_HOST_PORT:-11435})
  model    ${OLLAMA_MODEL:-unset}
  claude   run "claude" for Claude Code, wired to the model above
EOF
